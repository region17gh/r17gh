# Local env overrides. NOTE: .env itself is tracked in this repo and holds only
# public values (project URL, publishable keys). Server-only secrets --
# SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET_KEY -- belong in .dev.vars or
# .env.local, both ignored here, and never in .env.
.env.local
.env.*.local

