# Region 17 Ghana — environment variables.
#
# Names only. Never put a real value in this file: it is committed.
#
# WHERE A SECRET GOES. This file is the only environment file in the
# repository, and it holds names, never values. `.env` is git-ignored: it is
# yours, on your machine, and it does not come back here.
#
# It was tracked until 20260827, carrying only public values, and that is
# precisely the habit this ended. A tracked .env on a public repository is a
# slot -- the next person to add a variable adds it where the others already
# live, and the variable that finally matters is SUPABASE_SERVICE_ROLE_KEY.
# Nothing secret was ever committed; the slot was removed before it could be.
#
# So: values live in `.env`, `.dev.vars`, or `.env.local` locally -- all three
# are .gitignore'd -- and in the deployment's environment in production. If
# you find yourself typing a real value into THIS file, stop; it is committed.
#
# VITE_-prefixed variables are compiled into the browser bundle and are public
# by construction. Everything else is server-only and must stay that way.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# The one-time code length the Supabase project is set to issue. Advisory: it
# only powers a development warning. The join screen accepts the full range
# Supabase can issue regardless, and nothing in the UI decides this.
VITE_AUTH_OTP_LENGTH=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — the check in front of a member number
# ---------------------------------------------------------------------------
# Public site key. Compiled into the bundle, which is what a site key is for.
# Absent in a development checkout, which is the only case the stub covers.
VITE_TURNSTILE_SITE_KEY=

# Server only, and required in production. If it is missing, member numbers
# stop being issued: a challenge that cannot be checked has not been passed.
TURNSTILE_SECRET_KEY=

# Development only. Set to "true" to accept the stub token when no site key is
# configured. It cannot be turned on in production: the branch that honours it
# is guarded by `import.meta.env.DEV`, which Vite replaces with `false` when it
# builds for production, so the branch is not in the bundle at all. Setting
# this on a live deployment logs an error and does nothing else.
TURNSTILE_ALLOW_STUB=

# ---------------------------------------------------------------------------
# Resend — transactional email the application sends itself
# ---------------------------------------------------------------------------
# Separate from Supabase custom SMTP. That routes GoTrue's auth mail (the code,
# the sign-in link) through Resend and is configured in Supabase, not here.
# These are for mail the application sends: today, the welcome email.
#
# Server only.
RESEND_API_KEY=

# The From address, on the verified domain. Format: "Region 17 <name@domain>".
# Required: nothing is sent without it, and it is never guessed.
RESEND_FROM=

# Optional. Where a member's reply goes, if it should not go to the From address.
RESEND_REPLY_TO=

# The origin the welcome email's one link points at. Read here and never from
# the browser: a link in an email that the caller got to choose is a phishing
# vector. Defaults to https://r17gh.com.
SITE_URL=
