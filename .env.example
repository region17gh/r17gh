# Region 17 Ghana — environment variables.
#
# Names only. Never put a real value in this file: it is committed.
#
# WHERE A SECRET GOES. `.env` is tracked in this repository and holds only
# public values. A server-only secret must never be written into it. In
# production they are set in the deployment's environment; locally they go in
# `.dev.vars` or `.env.local`, both of which .gitignore excludes.
#
# VITE_-prefixed variables are compiled into the browser bundle and are public
# by construction. Everything else is server-only and must stay that way.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# The one-time code length the Supabase project is set to issue. Advisory: it
# only powers a development warning. The join screen accepts the full range
# Supabase can issue regardless, and nothing in the UI decides this.
VITE_AUTH_OTP_LENGTH=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — the check in front of a member number
# ---------------------------------------------------------------------------
# Public site key. Compiled into the bundle, which is what a site key is for.
# Absent in a development checkout, which is the only case the stub covers.
VITE_TURNSTILE_SITE_KEY=

# Server only, and required in production. If it is missing, member numbers
# stop being issued: a challenge that cannot be checked has not been passed.
TURNSTILE_SECRET_KEY=

# Development only. Set to "true" to accept the stub token when no site key is
# configured. It cannot be turned on in production: the branch that honours it
# is guarded by `import.meta.env.DEV`, which Vite replaces with `false` when it
# builds for production, so the branch is not in the bundle at all. Setting
# this on a live deployment logs an error and does nothing else.
TURNSTILE_ALLOW_STUB=
