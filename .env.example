# Region 17 Ghana — environment variables.
#
# Names only. Never put a real value in this file: it is committed.
#
# WHERE A SECRET GOES. `.env` is tracked in this repository and holds only
# public values. A server-only secret must never be written into it. In
# production they are set in the deployment's environment; locally they go in
# `.dev.vars` or `.env.local`, both of which .gitignore excludes.
#
# VITE_-prefixed variables are compiled into the browser bundle and are public
# by construction. Everything else is server-only and must stay that way.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# The one-time code length the Supabase project is set to issue. Advisory: it
# only powers a development warning. The join screen accepts the full range
# Supabase can issue regardless, and nothing in the UI decides this.
VITE_AUTH_OTP_LENGTH=

# ---------------------------------------------------------------------------
# Resend — transactional email the application sends itself
# ---------------------------------------------------------------------------
# Separate from Supabase custom SMTP. That routes GoTrue's auth mail (the code,
# the sign-in link) through Resend and is configured in Supabase, not here.
# These are for mail the application sends: today, the welcome email.
#
# Server only.
RESEND_API_KEY=

# The From address, on the verified domain. Format: "Region 17 <name@domain>".
# Required: nothing is sent without it, and it is never guessed.
RESEND_FROM=

# Optional. Where a member's reply goes, if it should not go to the From address.
RESEND_REPLY_TO=

# The origin the welcome email's one link points at. Read here and never from
# the browser: a link in an email that the caller got to choose is a phishing
# vector. Defaults to https://r17gh.com.
SITE_URL=
